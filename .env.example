# ============================================================================
# REGURDO — environment variables
# Copy this file to `.env.local` and fill in the values from:
# Supabase Dashboard -> Project Settings -> API
# ============================================================================

# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon public" key — safe for the browser (protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key — SERVER ONLY. Bypasses RLS.
# Never expose it to the browser and never prefix it with NEXT_PUBLIC_.
# Used by server actions for trusted admin jobs (e.g. storage cleanup).
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL — used for OAuth redirects and SEO metadata.
# Local dev: http://localhost:3000 | Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: extra hosts allowed to POST Server Actions (comma-separated).
# NEXT_PUBLIC_SITE_URL is added automatically; use this only for extra
# domains such as a www variant: "www.your-domain.com,staging.your-domain.com"
# SERVER_ACTIONS_EXTRA_ORIGINS=
